# local incluye login sin verificación por correo. Firebase exige configuración.
STORAGE_MODE=local
PORT=3001
# Solo se usa al crear users.json por primera vez.
LOCAL_ADMIN_PASSWORD=Vgm12345!
# Solo backend. Ruta a credencial fuera del repositorio; nunca VITE_.
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/service-account.json
FIREBASE_PROJECT_ID=
# UID iniciales permitidos. Después puedes crear cuentas desde Administración.
ALLOWED_UIDS=
# UID iniciales que tendrán rol administrador. Si se omite, usa ALLOWED_UIDS.
ADMIN_UIDS=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
